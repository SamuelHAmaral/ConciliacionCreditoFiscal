; Copy to config/cabo_config.ini for local smoke tests. Do not put secrets in git.
; Production: set SKIPPER_API_* and O365_* on the Kowalski account (not in this file).

[api]
base_url = http://192.168.0.61:8080
token_env = SKIPPER_API_TOKEN
timeout_seconds = 20
; PUT {"status": "En Ejecución"} at start, {"status": "Finalizado"} on success.
status_method = PUT

[paths]
; Relative paths are resolved from the project root.
salida_root = salidas

[email]
; CUADRE files go to Skipper data.user.email via Microsoft Graph (same Azure app as Vistazo).
; Prefer env vars on Kowalski: O365_CLIENT_ID, O365_CLIENT_SECRET, O365_TENANT_ID,
; CONCILIACION_EMAIL_FROM. Local-only copies can go here (gitignored cabo_config.ini).
to =
cc =
from =
o365_client_id =
o365_client_secret =
o365_tenant_id =
enabled = true
timeout_seconds = 30
use_outlook = false
